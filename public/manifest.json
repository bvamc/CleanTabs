{
  "manifest_version": 3,
  "name": "CleanTab",
  "description": "Local-first tab cleanup cockpit with snapshots and safe close suggestions.",
  "version": "0.1.0",
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "action": {
    "default_title": "Open CleanTab"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open CleanTab"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
